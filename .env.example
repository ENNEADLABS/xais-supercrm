# ===========================================
# ENNEAD Studio Creator — Variables d'environnement
# ===========================================
# Copier ce fichier en .env.local et remplir les valeurs
# cp .env.example .env.local

# --- Supabase (obligatoire) ---
# En local, recuperer ces valeurs avec : npx supabase@2.98.2 status -o env
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# --- API bot et administration (optionnel) ---
# Requis uniquement pour generer/utiliser les cles de l'API /api/v1.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
SUPABASE_JWT_SECRET=your-local-jwt-secret

# Limite facultative des comptes autorises, separes par des virgules.
# Vide = tous les comptes authentifies sont autorises.
ALLOWED_EMAILS=

# --- Email : Google OAuth (optionnel, pour email sync) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/emails/oauth/google/callback

# --- Email : Chiffrement tokens (optionnel, pour email sync) ---
# Generer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_ENCRYPTION_KEY=your-64-char-hex-key

# --- Rate limiting partage (optionnel, recommande en production) ---
# Sans ces deux valeurs, le developpement utilise un stockage en memoire.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sentry (optionnel) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
